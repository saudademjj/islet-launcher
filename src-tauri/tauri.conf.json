{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Islet",
  "version": "0.4.0",
  "identifier": "com.saudade.mclauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "草岛",
        "width": 1120,
        "height": 720,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "backgroundColor": "#17321f",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https: mcshot: http://mcshot.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Game",
    "publisher": "saudade",
    "homepage": "https://github.com/saudademjj/islet-launcher",
    "license": "GPL-3.0-only",
    "shortDescription": "A Minecraft: Java Edition launcher",
    "copyright": "Copyright (C) 2026 saudade. Minecraft is a trademark of Mojang Studios. Not affiliated with Mojang or Microsoft.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "mrpack"
        ],
        "name": "Modrinth Modpack",
        "description": "Minecraft Modrinth modpack",
        "mimeType": "application/x-modrinth-modpack",
        "role": "Editor"
      }
    ]
  }
}
