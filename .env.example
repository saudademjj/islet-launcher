# Copy to .env (not tracked) for local release builds; package-macos.sh reads it.
# Both values are compiled into the app, so set them before building.

# Microsoft sign-in: the Azure app's client ID (docs/azure-setup.md).
MC_LAUNCHER_CLIENT_ID=

# The update manifest's address (https). Without it the update check is off.
MC_LAUNCHER_UPDATE_URL=

# Optional: also write build/latest.json for this build's DMG. The DMG must be
# uploaded to RELEASE_BASE_URL + its file name; RELEASE_PAGE is the release page.
RELEASE_BASE_URL=
RELEASE_PAGE=

# Optional: Developer ID signing and notarization (package-macos.sh).
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_TEAM_ID=
APPLE_PASSWORD=
